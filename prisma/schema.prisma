generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  password  String
  role      Role     @default(ADMIN)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]

  @@map("categories")
}

model Product {
  id          String           @id @default(cuid())
  name        String
  slug        String           @unique
  description String
  price       Float
  salePrice   Float?
  weight      Float            @default(300)
  categoryId  String
  featured    Boolean          @default(false)
  isNew       Boolean          @default(false)
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  
  // Tax & Discount Settings
  ppnRate         Float        @default(0)
  pph23Rate       Float        @default(0)
  discountRate    Float        @default(0)
  showTaxDetails  Boolean      @default(false)

  flashSale   FlashSale?
  orderItems  OrderItem[]
  preOrderItems PreOrderItem[]
  preOrderCampaigns PreOrderCampaign[]
  images      ProductImage[]
  variants    ProductVariant[]
  category    Category         @relation(fields: [categoryId], references: [id])

  @@index([categoryId])
  @@index([isActive, createdAt])
  @@index([isActive, isNew])
  @@index([isActive, featured])
  @@map("products")
}

model ProductImage {
  id        String  @id @default(cuid())
  url       String
  alt       String?
  position  Int     @default(0)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_images")
}

model ProductVariant {
  id         String      @id @default(cuid())
  size       String
  stock      Int         @default(0)
  productId  String
  orderItems OrderItem[]
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, size])
  @@map("product_variants")
}

model Customer {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  phone     String?
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders    Order[]

  @@index([createdAt])
  @@map("customers")
}

model Order {
  id             String      @id @default(cuid())
  invoiceNumber  String      @unique
  customerName   String
  customerEmail  String
  customerId     String
  subtotal       Float
  taxPpn         Float       @default(0)
  taxPph23       Float       @default(0)
  totalDiscount  Float       @default(0)
  discount       Float       @default(0) // Coupon discount
  uniqueCode     Int
  totalWithCode  Float
  total          Float
  status         OrderStatus @default(UNPAID)
  notes          String?
  couponId       String?
  country        String      @default("ID")
  paymentMethod  String      @default("MANUAL_TRANSFER")
  shippingCost      Float       @default(0)
  trackingNumber    String?     // AWB/Resi
  trackingUrl       String?     // Biteship tracking URL
  courier           String?     // Courier name (JNT, JNE, etc.)
  shippingOrderId   String?     // External Order ID for Shipping
  subdistrictId     String?     // Rajaongkir Subdistrict ID
  expiredAt         DateTime
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  items          OrderItem[]
  coupon         Coupon?     @relation(fields: [couponId], references: [id])
  customer       Customer    @relation(fields: [customerId], references: [id])
  payment        Payment?

  @@index([invoiceNumber])
  @@index([status])
  @@index([expiredAt])
  @@map("orders")
}

model OrderItem {
  id        String         @id @default(cuid())
  orderId   String
  productId String
  variantId String
  quantity  Int
  price     Float
  size      String
  ppnAmount      Float      @default(0)
  pph23Amount    Float      @default(0)
  discountAmount Float      @default(0)
  order     Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@map("order_items")
}

model Payment {
  id             String        @id @default(cuid())
  orderId        String        @unique
  externalId     String        @unique
  invoiceUrl     String?
  paymentCode    String?
  amount         Float
  currency       String        @default("IDR")
  currencyAmount Float?        // Amount in display currency (e.g. USD)
  status         PaymentStatus @default(PENDING)
  method         String?
  paidAt         DateTime?
  paymentGatewayId String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  order          Order         @relation(fields: [orderId], references: [id])

  @@map("payments")
}

model Coupon {
  id            String       @id @default(cuid())
  code          String       @unique
  discountType  DiscountType
  discountValue Float
  minPurchase   Float        @default(0)
  maxDiscount   Float?
  usageLimit    Int?
  usageCount    Int          @default(0)
  isActive      Boolean      @default(true)
  expiresAt     DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  orders        Order[]

  @@map("coupons")
}

model FlashSale {
  id        String   @id @default(cuid())
  productId String   @unique
  salePrice Float
  startDate DateTime
  endDate   DateTime
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("flash_sales")
}

model VisitorLog {
  id        String   @id @default(cuid())
  sessionId String
  ip        String?
  country   String?
  city      String?
  device    String?
  browser   String?
  os        String?
  page      String
  referrer  String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([sessionId])
  @@index([country])
  @@index([page])
  @@map("visitor_logs")
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())

  @@map("newsletter_subscribers")
}

model SiteSettings {
  id    String @id @default(cuid())
  key   String @unique
  value String

  @@map("site_settings")
}

enum Role {
  ADMIN
}

enum OrderStatus {
  UNPAID
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  EXPIRED
  FAILED
}

enum PaymentStatus {
  PENDING
  PAID
  EXPIRED
  FAILED
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

model PreOrderCampaign {
  id          String   @id @default(cuid())
  name        String
  productId   String?
  product     Product? @relation(fields: [productId], references: [id])
  startDate   DateTime @default(now())
  endDate     DateTime?
  bannerUrl   String?
  isActive    Boolean  @default(true)
  
  preOrders   PreOrder[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("pre_order_campaigns")
}

model PreOrder {
  id             String   @id @default(cuid())
  preOrderNumber String   @unique
  customerName   String
  whatsapp       String
  address        String?
  orderDate      DateTime @default(now())
  notes          String?
  bankName       String?
  bankAccountName String?
  
  campaignId     String?
  campaign       PreOrderCampaign? @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  
  // Payment specifics
  dpPercentage   Float    @default(50)
  totalAmount    Float    @default(0)
  dpAmount       Float    @default(0)
  isPaid         Boolean  @default(false)
  
  dpProofUrl     String?
  fullProofUrl   String?
  status         PreOrderStatus @default(PENDING) // PENDING, DP_PAID, FULL_PAID, CANCELLED
  receiptNumber  String? // No Resi

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  
  items          PreOrderItem[]

  @@index([preOrderNumber])
  @@index([whatsapp])
  @@index([campaignId])
  @@map("pre_orders")
}

model PreOrderItem {
  id           String   @id @default(cuid())
  preOrderId   String
  
  // Can link to existing product or be custom
  productId    String?  
  product      Product? @relation(fields: [productId], references: [id])
  
  customName   String?
  customImage  String?  // Optional image if it's a new product
  
  size         String
  quantity     Int
  price        Float    @default(0)

  preOrder     PreOrder @relation(fields: [preOrderId], references: [id], onDelete: Cascade)

  @@map("pre_order_items")
}

enum PreOrderStatus {
  PENDING
  DP_PAID
  FULL_PAID
  CANCELLED
}
